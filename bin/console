#!/usr/bin/env php
<?php

declare(strict_types=1);

use Dotenv\Dotenv;

require_once dirname(__DIR__) . '/vendor/autoload.php';

$dotenv = Dotenv::createImmutable(dirname(__DIR__));
$dotenv->load();

$command = $argv[1] ?? null;

switch ($command) {
    case 'migrate':
        require_once dirname(__DIR__) . '/database/migrate.php';
        break;
    case 'seed':
        require_once dirname(__DIR__) . '/database/seed.php';
        break;
    case 'migrate:rollback':
        require_once dirname(__DIR__) . '/database/rollback.php';
        break;
    default:
        echo "Commandes disponibles: migrate, seed, migrate:rollback\n";
        exit(1);
}
