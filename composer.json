{
    "name": "universite/reservation-salles",
    "description": "Systeme de reservation de salles universitaires",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "illuminate/database": "^10.0",
        "illuminate/events": "^10.0",
        "nikic/fast-route": "^1.3",
        "php-di/php-di": "^7.0",
        "respect/validation": "^2.3",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "Rougui": "php bin/console",
        "migrate": "php bin/console migrate",
        "seed": "php bin/console seed",
        "rollback": "php bin/console migrate:rollback",
        "test": "phpunit",
        "cs-check": "phpcs --standard=PSR12 src",
        "cs-fix": "phpcbf --standard=PSR12 src"
    },
    "config": {
        "sort-packages": true
    }
}
